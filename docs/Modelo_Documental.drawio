          <mxGeometry height="28" width="360" x="960" y="110" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#888888;fontFamily=Courier New;" value="_id&lt;br&gt;files_id  ──► fs.files._id&lt;br&gt;n   (orden del fragmento)&lt;br&gt;data (BinData)" vertex="1">
          <mxGeometry height="82" width="360" x="960" y="138" as="geometry" />
        </mxCell>
        <mxCell id="n10" edge="1" parent="1" style="endArrow=open;endFill=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" value="1 : 1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="160" as="sourcePoint" />
            <mxPoint x="500" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n11" edge="1" parent="1" style="endArrow=open;endFill=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;" value="1 : N">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="160" as="sourcePoint" />
            <mxPoint x="860" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n12" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#D9650B;strokeColor=#D9650B;fontColor=#ffffff;" value="&lt;b&gt;Reserva atómica de cuota&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="640" x="40" y="330" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#D9650B;" value="&lt;font face=&quot;Courier New&quot;&gt;db.users.updateOne(&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;  { _id: ownerId, isActive: true,&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;    $or: [ { &quot;storage.quotaBytes&quot;: null },&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;           { $expr: { $lte: [ { $add: [&quot;$storage.usedBytes&quot;, size] }, &quot;$storage.quotaBytes&quot; ] } } ] },&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;  { $inc: { &quot;storage.usedBytes&quot;: size } }, { session })&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;matchedCount === 0&lt;/font&gt; → cuota excedida o usuario inactivo: abortar la transacción." vertex="1">
          <mxGeometry height="130" width="640" x="40" y="358" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#eeeeee;strokeColor=#888888;" value="&lt;b&gt;Reglas del contenido&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="600" x="720" y="330" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#888888;" value="• Solo &lt;font face=&quot;Courier New&quot;&gt;.txt&lt;/font&gt; y &lt;font face=&quot;Courier New&quot;&gt;.md&lt;/font&gt; (la categoría se deriva de la extensión); MIME permitido: &lt;font face=&quot;Courier New&quot;&gt;text/plain&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;text/markdown&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;text/x-markdown&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;application/octet-stream&lt;/font&gt;.&lt;br&gt;• UTF-8 validado en streaming con &lt;font face=&quot;Courier New&quot;&gt;TextDecoder(&quot;utf-8&quot;, { fatal: true })&lt;/font&gt; y &lt;font face=&quot;Courier New&quot;&gt;{ stream: true }&lt;/font&gt;.&lt;br&gt;• La extensión y el MIME se validan antes de crear el objeto GridFS para no dejar huérfanos.&lt;br&gt;• Sin límite individual de tamaño; el límite efectivo es la cuota.&lt;br&gt;• Editar contenido crea un objeto GridFS &lt;b&gt;nuevo&lt;/b&gt; y reemplaza &lt;font face=&quot;Courier New&quot;&gt;gridFsId&lt;/font&gt;; el anterior se borra tras el commit.&lt;br&gt;• Descargar sirve el stream como adjunto (nombre con fallback ASCII y &lt;font face=&quot;Courier New&quot;&gt;filename*&lt;/font&gt; UTF-8); la vista previa lo sirve en línea y no registra actividad." vertex="1">
          <mxGeometry height="205" width="600" x="720" y="358" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#eeeeee;strokeColor=#888888;" value="&lt;b&gt;Dos fases para mantener consistencia&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="640" x="40" y="508" as="geometry" />
        </mxCell>
        <mxCell id="n17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#888888;" value="&lt;b&gt;Carga:&lt;/b&gt; (1) stream a GridFS con validación UTF-8 → (2) transacción: reservar cuota + crear &lt;font face=&quot;Courier New&quot;&gt;files&lt;/font&gt; + share automático + log → si algo falla, borrar el objeto GridFS.&lt;br&gt;&lt;b&gt;Edición:&lt;/b&gt; (1) objeto GridFS nuevo → (2) transacción: delta de cuota + actualizar &lt;font face=&quot;Courier New&quot;&gt;files&lt;/font&gt; + log → (3) borrar el objeto anterior.&lt;br&gt;&lt;b&gt;Eliminación definitiva:&lt;/b&gt; (1) transacción de metadata, shares, cuota y log → (2) borrar objetos GridFS; si falla se registra &lt;font face=&quot;Courier New&quot;&gt;GRIDFS_DELETE_FAILED&lt;/font&gt; con el &lt;font face=&quot;Courier New&quot;&gt;gridFsId&lt;/font&gt;." vertex="1">
          <mxGeometry height="114" width="640" x="40" y="536" as="geometry" />
        </mxCell>
        <mxCell id="n18" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#eeeeee;strokeColor=#888888;" value="&lt;b&gt;Limpieza de GridFS huérfano&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="600" x="720" y="603" as="geometry" />
        </mxCell>
        <mxCell id="n19" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#888888;" value="El script de limpieza (&lt;font face=&quot;Courier New&quot;&gt;npm run db:cleanup-gridfs&lt;/font&gt;) lee los logs con &lt;font face=&quot;Courier New&quot;&gt;errorCode&lt;/font&gt; de GridFS, reintenta el borrado del &lt;font face=&quot;Courier New&quot;&gt;gridFsId&lt;/font&gt; guardado en &lt;font face=&quot;Courier New&quot;&gt;details&lt;/font&gt; y trata «archivo no encontrado» como éxito." vertex="1">
          <mxGeometry height="66" width="600" x="720" y="631" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
