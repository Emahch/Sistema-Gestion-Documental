  <diagram name="6. Seguridad y permisos" id="klDwF-ellB3WZ5UPL74c">
    <mxGraphModel dx="1554" dy="913" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1f3a5f;" value="&lt;b&gt;6. Seguridad, roles y permisos&lt;/b&gt;" vertex="1">
          <mxGeometry height="36" width="1500" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" value="El servidor decide siempre: el cliente nunca determina su identidad ni sus permisos (D-04)." vertex="1">
          <mxGeometry height="24" width="1500" x="40" y="58" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Autenticación&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="560" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" value="• Contraseñas con &lt;b&gt;bcrypt&lt;/b&gt;; nunca se devuelve &lt;font face=&quot;Courier New&quot;&gt;passwordHash&lt;/font&gt;.&lt;br&gt;• Login (U1) busca por &lt;font face=&quot;Courier New&quot;&gt;emailNormalized&lt;/font&gt; y emite un &lt;b&gt;JWT&lt;/b&gt; con &lt;font face=&quot;Courier New&quot;&gt;sub&lt;/font&gt; y &lt;font face=&quot;Courier New&quot;&gt;role&lt;/font&gt; (8 h por defecto).&lt;br&gt;• El id del usuario sale del &lt;font face=&quot;Courier New&quot;&gt;sub&lt;/font&gt; del token, no del cuerpo de la petición.&lt;br&gt;• &lt;b&gt;Cada petición protegida&lt;/b&gt; vuelve a validar &lt;font face=&quot;Courier New&quot;&gt;users.isActive&lt;/font&gt; (D-50): desactivar a alguien corta su acceso de inmediato." vertex="1">
          <mxGeometry height="114" width="560" x="40" y="128" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Autorización S3&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="560" x="40" y="258" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" value="• Una sola función centralizada decide el acceso a archivos y carpetas.&lt;br&gt;• Cortocircuito si el usuario es propietario.&lt;br&gt;• Si no, consulta &lt;font face=&quot;Courier New&quot;&gt;shares&lt;/font&gt; con &lt;font face=&quot;Courier New&quot;&gt;resourceId ∈ [recurso, carpeta, …ancestors]&lt;/font&gt; y &lt;font face=&quot;Courier New&quot;&gt;sharedWithId&lt;/font&gt;; gana el permiso más alto (&lt;font face=&quot;Courier New&quot;&gt;edit&lt;/font&gt; &amp;gt; &lt;font face=&quot;Courier New&quot;&gt;read&lt;/font&gt;).&lt;br&gt;• Un recurso con &lt;font face=&quot;Courier New&quot;&gt;isDeleted: true&lt;/font&gt; solo es visible para su propietario en la papelera.&lt;br&gt;• Los permisos heredados &lt;b&gt;no se almacenan&lt;/b&gt;: se calculan." vertex="1">
          <mxGeometry height="130" width="560" x="40" y="286" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Validación de entradas&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="560" x="40" y="432" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" value="• Extensión &lt;font face=&quot;Courier New&quot;&gt;.txt&lt;/font&gt; / &lt;font face=&quot;Courier New&quot;&gt;.md&lt;/font&gt; y MIME permitido; &lt;font face=&quot;Courier New&quot;&gt;category&lt;/font&gt; se deriva de la extensión.&lt;br&gt;• UTF-8 válido con &lt;font face=&quot;Courier New&quot;&gt;TextDecoder&lt;/font&gt; en modo &lt;font face=&quot;Courier New&quot;&gt;fatal&lt;/font&gt; y en streaming.&lt;br&gt;• El texto de búsqueda se &lt;b&gt;escapa&lt;/b&gt; antes de construir el regex.&lt;br&gt;• CORS limitado al origen &lt;font face=&quot;Courier New&quot;&gt;CLIENT_URL&lt;/font&gt;.&lt;br&gt;• Secretos solo por variables de entorno; &lt;font face=&quot;Courier New&quot;&gt;.env&lt;/font&gt; fuera del repositorio." vertex="1">
          <mxGeometry height="98" width="560" x="40" y="460" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9e9e9e;" value="&lt;b&gt;Operación&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="330" x="640" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9e9e9e;" value="&lt;b&gt;Lectura&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="90" x="970" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9e9e9e;" value="&lt;b&gt;Edición&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="90" x="1060" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9e9e9e;" value="&lt;b&gt;Propietario&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="110" x="1150" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9e9e9e;" value="&lt;b&gt;Admin (rol)&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="110" x="1260" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#bdbdbd;" value="Listar, descargar, vista previa" vertex="1">
          <mxGeometry height="28" width="330" x="640" y="128" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#bdbdbd;" value="Sí" vertex="1">
          <mxGeometry height="28" width="90" x="970" y="128" as="geometry" />
        </mxCell>
        <mxCell id="n17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#bdbdbd;" value="Sí" vertex="1">
          <mxGeometry height="28" width="90" x="1060" y="128" as="geometry" />
        </mxCell>
        <mxCell id="n18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#bdbdbd;" value="Sí" vertex="1">
