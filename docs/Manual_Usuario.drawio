        <mxCell id="n19" parent="1" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Recuerda:&lt;/b&gt; el rol de administrador sirve para supervisar. No permite abrir ni descargar los archivos de otras personas, y todas las acciones administrativas (creación de usuario, cambio de estado, cambio de cuota) quedan registradas en el historial." vertex="1">
          <mxGeometry height="50" width="1280" x="40" y="312" as="geometry" />
        </mxCell>
      </root>
