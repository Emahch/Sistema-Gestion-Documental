        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" value="Es la pantalla principal: muestra el contenido de la carpeta en la que estás." vertex="1">
          <mxGeometry height="24" width="1500" x="40" y="58" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Qué verás&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="600" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" value="• &lt;b&gt;Ruta de navegación (breadcrumb):&lt;/b&gt; indica dónde estás y permite volver a una carpeta superior.&lt;br&gt;• &lt;b&gt;Listado&lt;/b&gt; de carpetas y archivos, ordenado por nombre, con paginación.&lt;br&gt;• &lt;b&gt;Tus recursos&lt;/b&gt; y los que &lt;b&gt;otras personas compartieron contigo&lt;/b&gt; (con su permiso).&lt;br&gt;• Datos de cada archivo: nombre, tipo (TXT o MD), tamaño, fecha y propietario.&lt;br&gt;• Acciones sobre cada elemento según tus permisos." vertex="1">
          <mxGeometry height="120" width="600" x="40" y="128" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Tu carpeta raíz&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="600" x="40" y="268" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" value="• Cada usuario tiene una carpeta raíz única donde empieza todo.&lt;br&gt;• La raíz &lt;b&gt;no&lt;/b&gt; puede renombrarse, moverse, eliminarse ni compartirse." vertex="1">
          <mxGeometry height="52" width="600" x="40" y="296" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Si falta alguna carpeta en la ruta&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="600" x="40" y="368" as="geometry" />
        </mxCell>
