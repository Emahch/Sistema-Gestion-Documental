  <diagram name="12. Reportes" id="aU7XGhXC7W9lOJsvKE2J">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1f3a5f;" value="&lt;b&gt;12. Reportes (administrador)&lt;/b&gt;" vertex="1">
          <mxGeometry height="36" width="1500" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" value="Menú «Reportes» (/reports). Cuatro pestañas; cada una carga su información al abrirla. Solo cuentan operaciones exitosas." vertex="1">
          <mxGeometry height="24" width="1500" x="40" y="58" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Pestaña · Archivos y almacenamiento&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="520" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" value="• &lt;b&gt;Cantidad de archivos agrupados por tipo&lt;/b&gt; (TXT, MD) con tamaño total.&lt;br&gt;• &lt;b&gt;Archivos almacenados en un rango de fechas&lt;/b&gt; (Desde / Hasta → Consultar).&lt;br&gt;• &lt;b&gt;Archivos con mayor cantidad de operaciones&lt;/b&gt; (filtro opcional por fechas → Filtrar)." vertex="1">
          <mxGeometry height="82" width="520" x="40" y="128" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Pestaña · Usuarios&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="520" x="600" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" value="• &lt;b&gt;Top 10 usuarios&lt;/b&gt; con mayor cantidad de archivos almacenados (cantidad y tamaño).&lt;br&gt;• &lt;b&gt;Usuarios con mayor cantidad de recursos compartidos&lt;/b&gt; (manuales y automáticos)." vertex="1">
          <mxGeometry height="82" width="520" x="600" y="128" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Pestaña · Compartición&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="520" x="40" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" value="• &lt;b&gt;Archivos compartidos con mayor cantidad de usuarios&lt;/b&gt; (solo comparticiones manuales).&lt;br&gt;• &lt;b&gt;Recursos compartidos por un usuario seleccionado.&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Recursos recibidos por un usuario seleccionado.&lt;/b&gt;" vertex="1">
          <mxGeometry height="82" width="520" x="40" y="378" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Pestaña · Actividad&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="520" x="600" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;" value="• &lt;b&gt;Historial de actividad de un usuario&lt;/b&gt; en un rango de fechas.&lt;br&gt;• &lt;b&gt;Cantidad de operaciones por tipo&lt;/b&gt; y principales acciones del sistema.&lt;br&gt;• &lt;b&gt;Cantidad de operaciones por período&lt;/b&gt; (Granularidad: Día, Semana o Mes)." vertex="1">
          <mxGeometry height="66" width="520" x="600" y="378" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Cómo usar los filtros&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="1080" x="40" y="620" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;" value="• &lt;b&gt;Fechas:&lt;/b&gt; elige Desde y Hasta con el selector de fecha (dd/mm/aaaa). La consulta incluye el día completo de ambas fechas.&lt;br&gt;• &lt;b&gt;Usuario:&lt;/b&gt; elige a la persona en la lista desplegable; los resultados se actualizan al seleccionarla o al pulsar Consultar.&lt;br&gt;• &lt;b&gt;Tablas largas:&lt;/b&gt; usa la paginación inferior para ver más resultados.&lt;br&gt;• Los reportes del administrador solo muestran información general (nombres, cantidades, tamaños), nunca el contenido de los archivos." vertex="1">
          <mxGeometry height="82" width="1080" x="40" y="648" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
