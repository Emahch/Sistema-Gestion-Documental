  <diagram name="1. Introducción" id="EBfvF2jtW56CBznq9zql">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1f3a5f;" value="&lt;b&gt;1. Introducción, roles y reglas generales&lt;/b&gt;" vertex="1">
          <mxGeometry height="36" width="1500" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" value="Aplicación web para guardar, organizar, compartir y revisar documentos de texto." vertex="1">
          <mxGeometry height="24" width="1500" x="40" y="58" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;¿Para qué sirve?&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="620" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" value="• Guardar documentos &lt;b&gt;.txt&lt;/b&gt; y &lt;b&gt;.md&lt;/b&gt; en carpetas propias.&lt;br&gt;• Compartirlos con otras personas con permiso de lectura o de edición.&lt;br&gt;• Recuperar archivos borrados desde la papelera.&lt;br&gt;• Ver quién hizo qué sobre tus archivos (historial de actividad).&lt;br&gt;• Si eres administrador: crear usuarios, definir cuotas y consultar reportes." vertex="1">
          <mxGeometry height="103" width="620" x="40" y="128" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Cómo entrar&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="620" x="40" y="251" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" value="• Abre el sistema en tu navegador (por ejemplo http://localhost:4200 en un entorno local).&lt;br&gt;• Tu cuenta la crea el administrador; no existe registro propio.&lt;br&gt;• Funciona en los navegadores modernos (Chrome, Edge, Firefox)." vertex="1">
          <mxGeometry height="86" width="620" x="40" y="279" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=8;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Reglas generales que conviene recordar&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="620" x="40" y="385" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#d6b656;" value="• Solo se aceptan archivos &lt;b&gt;.txt&lt;/b&gt; y &lt;b&gt;.md&lt;/b&gt;, con codificación &lt;b&gt;UTF-8&lt;/b&gt; (tildes y ñ correctas).&lt;br&gt;• No hay límite de tamaño por archivo; el límite es tu &lt;b&gt;cuota&lt;/b&gt; de almacenamiento (puede ser ilimitada).&lt;br&gt;• Dos elementos en la misma carpeta no pueden tener el mismo nombre (no distingue mayúsculas ni tildes).&lt;br&gt;• Todo lo que borras va primero a la &lt;b&gt;papelera&lt;/b&gt;." vertex="1">
          <mxGeometry height="137" width="620" x="40" y="413" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9e9e9e;" value="&lt;b&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="200" x="700" y="100" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9e9e9e;" value="&lt;b&gt;Usuario&lt;/b&gt;" vertex="1">
