        <mxCell id="n11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f7f9fc;strokeColor=#bdbdbd;" value="Cambia el estado del usuario." vertex="1">
          <mxGeometry height="44" width="600" x="260" y="172" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f7f9fc;strokeColor=#bdbdbd;" value="No se eliminan usuarios. Desactivar conserva sus archivos, carpetas, permisos e historial; el usuario no podrá ingresar ni recibir comparticiones." vertex="1">
          <mxGeometry height="44" width="520" x="860" y="172" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#bdbdbd;" value="Ajustar la cuota" vertex="1">
          <mxGeometry height="44" width="220" x="40" y="216" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#bdbdbd;" value="Define un nuevo límite en bytes o ilimitada." vertex="1">
          <mxGeometry height="44" width="600" x="260" y="216" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#bdbdbd;" value="Bajarla por debajo del espacio usado solo bloquea nuevas cargas; no elimina nada." vertex="1">
          <mxGeometry height="44" width="520" x="860" y="216" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f7f9fc;strokeColor=#bdbdbd;" value="Consultar el listado" vertex="1">
          <mxGeometry height="28" width="220" x="40" y="260" as="geometry" />
        </mxCell>
        <mxCell id="n17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f7f9fc;strokeColor=#bdbdbd;" value="Revisa los usuarios, con filtros por rol y estado." vertex="1">
          <mxGeometry height="28" width="600" x="260" y="260" as="geometry" />
        </mxCell>
        <mxCell id="n18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#f7f9fc;strokeColor=#bdbdbd;" value="Nunca se muestran las contraseñas." vertex="1">
